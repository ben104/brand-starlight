---
import Default from "@astrojs/starlight/components/Footer.astro";
import brand from "../brand/brand.config.json";

/**
 * Starlight's footer, plus the page actions.
 *
 * There is deliberately no "Edit page" link: editing needs repository write access, which
 * almost nobody viewing this site has, so the default link sent most readers to a GitHub
 * 404.
 *
 * There is also deliberately no mailto: link. A mailto fails *silently* on any machine
 * without a registered mail handler — which is common on desktop Chrome with webmail — and
 * a button that does nothing at all when clicked is worse than no button. The address is
 * shown as plain selectable text instead, so it works everywhere.
 *
 * The page title goes in the text so a request still arrives identifiable: "Brand Colours"
 * rather than "something on the site is wrong". That context was the reason for the
 * pre-filled mailto, and it is worth keeping without it.
 */
const { entry } = Astro.locals.starlightRoute;

const slug = String(entry.id).replace(/\.mdx?$/, "") || "index";
const rawHref = `/raw/${slug}.md`;
const filename = `${slug.split("/").pop() || "page"}.md`;

const title = entry.data?.title ?? slug;
const changesTo = brand.contact?.changes;
---

<div class="page-actions">
  {
    changesTo && (
      <p class="suggest">
        Something wrong on this page? Email <strong>{changesTo}</strong> and mention
        &ldquo;{title}&rdquo;.
      </p>
    )
  }
  <a class="download" href={rawHref} download={filename}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    Download this page as Markdown
  </a>
</div>

<Default><slot /></Default>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block: 1.5rem 0;
  }
  .suggest {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .suggest strong {
    color: var(--sl-color-white);
    font-weight: 600;
    /* The address has to be selectable — copying it is how most people will use it. */
    user-select: all;
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-sm, 3px);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }
</style>
