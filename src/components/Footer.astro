---
import Default from "@astrojs/starlight/components/Footer.astro";

/**
 * Starlight's footer, plus a link to download the page as Markdown.
 *
 * The file it links to is generated by scripts/build-raw-markdown.mjs, which substitutes
 * every component for Markdown built from the same tokens and asset manifest the component
 * renders from — so the download carries the real colours and file links, not a stub.
 *
 * This is the whole reason the hub exists in a repo: people paste these pages into Claude.
 */
const { entry } = Astro.locals.starlightRoute;

// Astro's content layer strips the extension from `id`, but be tolerant either way.
// The home page's id is an empty string, which would produce "/raw/.md".
const slug = String(entry.id).replace(/\.mdx?$/, "") || "index";
const rawHref = `/raw/${slug}.md`;
const filename = `${slug.split("/").pop() || "page"}.md`;
---

<div class="page-actions">
  <a href={rawHref} download={filename}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    Download this page as Markdown
  </a>
</div>

<Default><slot /></Default>

<style>
  .page-actions {
    display: flex;
    justify-content: flex-end;
    margin-block: 1.5rem 0;
  }
  .page-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-sm, 3px);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .page-actions a:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }
</style>
