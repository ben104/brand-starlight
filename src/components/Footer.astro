---
import Default from "@astrojs/starlight/components/Footer.astro";
import brand from "../brand/brand.config.json";

/**
 * Starlight's footer, plus two page actions.
 *
 * There is deliberately no "Edit page" link. Editing requires write access to the brand
 * repository, which almost nobody viewing this site has — so the default link sent most
 * readers to a GitHub 404, which reads as the site being broken rather than as a
 * permission they lack. The few people who do have access know where the repository is,
 * and CONTRIBUTING.md documents the flow.
 *
 * What replaces it is a change request that arrives with context: the page title and URL
 * are pre-filled, so the brand manager gets "Brand Colours — https://…/colours/" instead
 * of "something on the site is wrong".
 */
const { entry } = Astro.locals.starlightRoute;

const slug = String(entry.id).replace(/\.mdx?$/, "") || "index";
const rawHref = `/raw/${slug}.md`;
const filename = `${slug.split("/").pop() || "page"}.md`;

const title = entry.data?.title ?? slug;
const pageUrl = new URL(slug === "index" ? "/" : `/${slug}/`, brand.site).href;

const changesTo = brand.contact?.changes;
const suggestHref = changesTo
  ? `mailto:${changesTo}?subject=${encodeURIComponent(`${brand.siteTitle}: ${title}`)}&body=${encodeURIComponent(
      `Page: ${pageUrl}\n\nWhat needs changing:\n\n`
    )}`
  : undefined;
---

<div class="page-actions">
  {
    suggestHref && (
      <a href={suggestHref}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        Suggest a change
      </a>
    )
  }
  <a href={rawHref} download={filename}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    Download this page as Markdown
  </a>
</div>

<Default><slot /></Default>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-block: 1.5rem 0;
  }
  .page-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-sm, 3px);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .page-actions a:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }
</style>
