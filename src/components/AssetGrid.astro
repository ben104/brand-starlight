---
import assets from "../brand/assets.json";
import DownloadButton from "./DownloadButton.astro";

/**
 * Renders an asset catalogue from the brand's generated manifest.
 *
 * Nothing here is hand-listed. Dropping a logo into the brand repo and rebuilding the
 * manifest puts it on the page — there is no markdown table to forget to update.
 */
interface Props {
  kind: "logos" | "favicons" | "illustrations" | "imagery" | "accreditations";
}
const { kind } = Astro.props;

const label = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

/** Preview a logo on a dark tile when the artwork itself is white. */
const isKnockout = (variant: string) => variant === "white";
---

{
  kind === "logos" &&
    assets.logos.map((brand: any) => (
      <section class="asset-brand">
        <h3>{brand.name}</h3>
        <div class="asset-grid">
          {brand.variants.map((variant: any) => (
            <figure class={`asset-card${isKnockout(variant.variant) ? " asset-card--dark" : ""}`}>
              <div class="asset-preview">
                <img src={variant.files.png?.url ?? variant.files.svg.url} alt={`${brand.name} — ${variant.variant}`} loading="lazy" />
              </div>
              <figcaption>
                <strong>{label(variant.variant)}</strong>
                <span class="asset-note">{variant.description}</span>
                <div class="asset-downloads">
                  {Object.entries(variant.files).map(([format, file]: [string, any]) => (
                    <DownloadButton href={file.url} label={format.toUpperCase()} bytes={file.bytes} />
                  ))}
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))
}

{
  kind === "favicons" && (
    <div class="asset-grid asset-grid--small">
      {assets.favicons.map((icon: any) => (
        <figure class="asset-card">
          <div class="asset-preview asset-preview--tight">
            <img src={icon.files.png?.url ?? icon.files.svg.url} alt={`${icon.slug} favicon`} loading="lazy" width="48" height="48" />
          </div>
          <figcaption>
            <strong>{label(icon.slug)}</strong>
            <div class="asset-downloads">
              {Object.entries(icon.files).map(([format, file]: [string, any]) => (
                <DownloadButton href={file.url} label={format.toUpperCase()} bytes={file.bytes} />
              ))}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

{
  kind === "illustrations" &&
    assets.illustrations.map((set: any) => (
      <section class="asset-brand">
        <h3>{set.name}</h3>
        <div class="asset-grid">
          {set.files.map((file: any) => (
            <figure class={`asset-card${file.colourway === "alpha" ? " asset-card--checkered" : ""}`}>
              <div class="asset-preview">
                <img src={file.url} alt={`${set.name} — ${file.colourway}`} loading="lazy" />
              </div>
              <figcaption>
                <strong>{label(file.colourway)}</strong>
                <div class="asset-downloads">
                  <DownloadButton href={file.url} label="GIF" bytes={file.bytes} />
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))
}

{
  (kind === "imagery" || kind === "accreditations") &&
    (assets as any)[kind].map((group: any) => (
      <section class="asset-brand">
        <h3>{group.heading}</h3>
        <div class="asset-grid">
          {group.items.map((item: any) => (
            <figure class="asset-card">
              <div class="asset-preview">
                <img src={item.url} alt={item.name} loading="lazy" />
              </div>
              <figcaption>
                <strong>{item.name}</strong>
                {item.note && <span class="asset-note">{item.note}</span>}
                <code class="asset-filename">{item.file}</code>
                <div class="asset-downloads">
                  <DownloadButton href={item.url} label="Download" bytes={item.bytes} />
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))
}

<style>
  .asset-brand { margin-block: 2.5rem; }
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .asset-grid--small { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .asset-card {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
  }
  .asset-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    padding: 1rem;
    background: var(--color-core-white, #fff);
  }
  .asset-preview--tight { min-height: 80px; }
  .asset-preview img { max-width: 100%; max-height: 110px; height: auto; object-fit: contain; }
  /* White artwork is invisible on white — preview it on the brand's own dark tone. */
  .asset-card--dark .asset-preview { background: var(--color-core-navy, #2b363b); }
  /* Transparent GIFs need something behind them to read as transparent. */
  .asset-card--checkered .asset-preview {
    background-color: #fff;
    background-image:
      linear-gradient(45deg, #e6e6e6 25%, transparent 25%),
      linear-gradient(-45deg, #e6e6e6 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e6e6e6 75%),
      linear-gradient(-45deg, transparent 75%, #e6e6e6 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.85rem;
  }
  .asset-note { color: var(--sl-color-gray-3); font-size: 0.78rem; line-height: 1.4; }
  .asset-filename { font-size: 0.7rem; background: none; padding: 0; color: var(--sl-color-gray-3); word-break: break-all; }
  .asset-downloads { display: flex; flex-wrap: wrap; margin-top: 0.25rem; }
</style>
